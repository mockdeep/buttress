#!/usr/bin/env ruby
# frozen_string_literal: true

# Generates a spec file for every class under DIR that has public
# methods or macro readers — and every module with public singleton
# methods — writing each to its conventional spec location
# (lib/foo/bar.rb -> spec/foo/bar_spec.rb). The Writer refuses to
# overwrite, so existing spec files are reported as collisions and
# left alone — delete or move them first to regenerate.
#
# usage: bin/generate DIR [TARGET_RUBY_VERSION]

require_relative "../lib/buttress"

dir = ARGV.first or abort "usage: bin/generate DIR [TARGET_RUBY_VERSION]"
target_version = ARGV[1]
target = Buttress::Target.new(target_version)

written = []
collisions = []
empties = []
failures = []

Dir.glob(File.join(dir, "**", "*.rb")).sort.each do |file|
  begin
    root = RootNode.new(target.parse(File.read(file)))
  rescue StandardError => error
    failures << [file, "parse: #{error.message[0, 100]}"]
    next
  end

  subjects = root.class_names.map { |name| [name, false] } +
    root.module_names.map { |name| [name, true] }
  subjects.each do |class_name, is_module|
    node = is_module ? root.find_module(class_name) : root.lookup_class(class_name)
    next if node.nil?

    # A module is a subject only through its singleton methods.
    if is_module
      next if node.public_singleton_method_names.empty?
    elsif node.public_method_names.empty? &&
          node.public_singleton_method_names.empty? &&
          node.public_reader_names.empty?
      next
    end

    begin
      written << Buttress::Runner.call(file, class_name, target_version)
    rescue Buttress::Error => error
      if error.message.start_with?("refusing to overwrite")
        collisions << [class_name, error.message[/refusing to overwrite existing (.*)/, 1]]
      elsif error.message.start_with?("nothing to assert")
        empties << class_name
      else
        failures << ["#{file} (#{class_name})", error.message[0, 100]]
      end
    end
  end
end

puts "=== Written (#{written.count}) ==="
written.each { |path| puts "  #{path}" }

if collisions.any?
  puts "\n=== Collisions (#{collisions.count}) — delete to regenerate ==="
  collisions.each { |name, path| puts "  #{path}  (#{name})" }
end

if empties.any?
  puts "\n=== Nothing to assert (#{empties.count}) — every flow filtered ==="
  empties.each { |name| puts "  #{name}" }
end

if failures.any?
  puts "\n=== Failures (#{failures.count}) ==="
  failures.each { |site, message| puts "  #{site}: #{message}" }
end
