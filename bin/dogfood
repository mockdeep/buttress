#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs buttress across every class in a directory and tallies the
# results: how many paths generate concrete tests, how many degrade to
# skips (grouped by reason), and what crashes outright. The output is an
# evidence-ranked backlog. Nothing is written to disk.
#
# usage: bin/dogfood DIR [TARGET_RUBY_VERSION]

require_relative "../lib/buttress"

dir = ARGV.first or abort "usage: bin/dogfood DIR [TARGET_RUBY_VERSION]"
target = Buttress::Target.new(ARGV[1])

stats = Hash.new(0)
skips = Hash.new(0)
crashes = Hash.new { |hash, key| hash[key] = [] }
sources_cache = {}

Dir.glob(File.join(dir, "**", "*.rb")).sort.each do |file|
  code = File.read(file)
  root_dir = Buttress::Sources.find_root(File.expand_path(File.dirname(file)))
  sources = root_dir &&
    (sources_cache[root_dir] ||= Buttress::Sources.new(root_dir, target: target))
  begin
    root = RootNode.new(target.parse(code))
  rescue StandardError => error
    crashes["parse: #{error.message[0, 100]}"] << file
    next
  end

  subjects = root.class_names.map { |name| [name, false] } +
    root.module_names.map { |name| [name, true] }
  subjects.each do |class_name, is_module|
    begin
      node = is_module ? root.find_module(class_name) : root.find_class(class_name)
    rescue StandardError => error
      crashes["find_class: #{error.message[0, 100]}"] << class_name
      next
    end
    next if node.nil?

    # A module contributes only singleton methods (instance methods
    # have no constructible receiver); namespace-only wrappers with
    # none don't count as subjects.
    methods = node.public_singleton_method_names.map { |name| [name, true] }
    methods = node.public_method_names.map { |name| [name, false] } + methods unless is_module
    next if is_module && methods.empty?

    stats[is_module ? :modules : :classes] += 1

    methods.each do |method_name, singleton|
      stats[:methods] += 1
      begin
        output = Buttress::Composer.call(
          code, class_name, method_name.to_s, target: target, sources: sources,
          singleton: singleton,
        )
      rescue StandardError => error
        stats[:crashed_methods] += 1
        message = "#{error.class}: #{error.message[0, 100]}"
        crashes[message] << "#{class_name}#{singleton ? '.' : '#'}#{method_name}"
        next
      end

      tests = output.scan(/^\s*it '/).count
      skipped = output.scan(/(?:skip|pending) '([^']*)'/).flatten
      stats[:tests] += tests
      stats[:skipped] += skipped.count
      stats[:concrete] += tests - skipped.count
      skipped.each { |reason| skips[reason] += 1 }
    end
  end
end

puts "=== Totals ==="
%i[classes modules methods crashed_methods tests concrete skipped].each do |key|
  puts format("%-16s %d", key, stats[key])
end

if stats[:tests].positive?
  rate = 100.0 * stats[:concrete] / stats[:tests]
  puts format("concrete rate    %.1f%%", rate)
end

puts "\n=== Skip reasons (top 25) ==="
skips.sort_by { |_, count| -count }.first(25).each do |reason, count|
  puts format("%4d  %s", count, reason)
end

puts "\n=== Crashes ==="
crashes.sort_by { |_, sites| -sites.count }.each do |message, sites|
  puts format("%4d  %s", sites.count, message)
  sites.first(3).each { |site| puts "        e.g. #{site}" }
end
