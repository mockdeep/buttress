<%= target.describe %> <%= class_name %>, '<%= flow_tree.method_label %>' do
<% flow_tree.flows.each_with_index do |flow, index| -%>
<% if index.positive? -%>

<% end -%>
  it '<%= flow.description %>' do
<% if flow.skip_reason -%>
    <%= target.skip(flow.skip_reason) %>

<% end -%>
<% unless flow.singleton -%>
    <%= flow.instance_name %> = <%= flow.constructor_call %>

<% end -%>
<% if flow.skip_reason -%>
    <%= flow.subject %>
<% elsif flow.type_assertion_class -%>
    <%= target.type_assertion(flow.subject, flow.type_assertion_class) %>
<% else -%>
    <%= target.assertion(flow.subject, flow.return_value) %>
<% end -%>
  end
<% end -%>
end
